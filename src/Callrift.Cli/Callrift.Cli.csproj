<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>callrift</AssemblyName>
    <RootNamespace>Callrift.Cli</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>callrift</ToolCommandName>
    <PackageId>callrift</PackageId>
    <Description>Semantic C# call stack diffs for code review, PR descriptions, and agents.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Callrift.Core/Callrift.Core.csproj" />
    <ProjectReference Include="../Callrift.MSBuild/Callrift.MSBuild.csproj" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <Target Name="IncludeWorkspaceWorker" BeforeTargets="GetCopyToOutputDirectoryItems">
    <ItemGroup>
      <WorkspaceWorkerFile Include="../Callrift.MSBuild/bin/$(Configuration)/$(TargetFramework)/**/*" />
      <ContentWithTargetPath Include="@(WorkspaceWorkerFile)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="msbuild/%(WorkspaceWorkerFile.RecursiveDir)%(WorkspaceWorkerFile.Filename)%(WorkspaceWorkerFile.Extension)" />
    </ItemGroup>
  </Target>
</Project>
