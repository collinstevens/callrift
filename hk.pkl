amends "package://github.com/jdx/hk/releases/download/v2.3.0/hk@2.3.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.3.0/hk@2.3.0#/Builtins.pkl"

steps {
  ["check-case-conflict"] = (Builtins.check_case_conflict) {
    allow_binary = true
    allow_symlinks = true
  }
  ["check-merge-conflict"] = Builtins.check_merge_conflict
  ["dotnet-format"] = (Builtins.dotnet_format) {
    check {
      command {
        argv = List("dotnet", "format", "callrift.slnx", "--no-restore", "--verify-no-changes", "--include", "{{files}}")
      }
    }
    fix {
      command {
        argv = List("dotnet", "format", "callrift.slnx", "--no-restore", "--include", "{{files}}")
      }
    }
  }
  ["editorconfig-checker"] = Builtins.editorconfig_checker
}

hooks {
  ["commit-msg"] {
    steps {
      ["conventional-commit"] = Builtins.check_conventional_commit
    }
  }
}
