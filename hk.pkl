amends "package://github.com/jdx/hk/releases/download/v2.1.0/hk@2.1.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.1.0/hk@2.1.0#/Builtins.pkl"

min_hk_version = "2.1.0"

steps {
  ["editorconfig"] = Builtins.editorconfig_checker
  ["dotnet-format"] = (Builtins.dotnet_format) {
    check = new CommandSpec {
      command = new Command {
        argv = List("dotnet", "format", "--no-restore", "--verify-no-changes", "--include", "{{files}}")
      }
      effect = "write"
    }
    fix = new CommandSpec {
      command = new Command {
        argv = List("dotnet", "format", "--no-restore", "--include", "{{files}}")
      }
      effect = "write"
    }
  }
}

hooks {
  ["pre-commit"] {
    fix = false
    stage = false
    stash = "git"
  }
  ["commit-msg"] {
    steps {
      ["conventional-commits"] = (Builtins.check_conventional_commit) {
        check = new CommandSpec {
          command = new Command {
            argv = List("hk", "util", "check-conventional-commit", "{{commit_msg_file}}")
          }
          effect = "read"
        }
      }
    }
  }
}
