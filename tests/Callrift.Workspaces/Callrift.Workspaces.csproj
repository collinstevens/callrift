<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Callrift.Cli/Callrift.Cli.csproj" />
    <ProjectReference Include="../../tools/Callrift.FixtureWorker/Callrift.FixtureWorker.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="Verify.Xunit" />
    <Compile Include="../Callrift.Scenarios/FixtureDirectory.cs" Link="FixtureDirectory.cs" />
    <Compile Include="../Callrift.Scenarios/GitFixture.cs" Link="GitFixture.cs" />
    <Compile Include="../Callrift.Scenarios/ScenarioCatalog.cs" Link="ScenarioCatalog.cs" />
    <Compile Include="../Callrift.Scenarios/WorkspaceFixture.cs" Link="WorkspaceFixture.cs" />
    <Compile Include="../Callrift.Scenarios/FixtureProjectShape.cs" Link="FixtureProjectShape.cs" />
    <Compile Include="../Callrift.Scenarios/ScenarioWorkspaceFixture.cs" Link="ScenarioWorkspaceFixture.cs" />
    <Compile Include="../Callrift.Scenarios/ScenarioTestFramework.cs" Link="ScenarioTestFramework.cs" />
    <Compile Include="../../tools/Callrift.FixtureWorker/FixtureWorkerRequest.cs" Link="FixtureWorkerRequest.cs" />
  </ItemGroup>
  <Target Name="IncludeFixtureWorker" BeforeTargets="GetCopyToOutputDirectoryItems">
    <ItemGroup>
      <FixtureWorkerFile Include="../../tools/Callrift.FixtureWorker/bin/$(Configuration)/$(TargetFramework)/**/*" />
      <ContentWithTargetPath Include="@(FixtureWorkerFile)" CopyToOutputDirectory="PreserveNewest" TargetPath="fixture-worker/%(FixtureWorkerFile.RecursiveDir)%(FixtureWorkerFile.Filename)%(FixtureWorkerFile.Extension)" />
    </ItemGroup>
  </Target>
</Project>
